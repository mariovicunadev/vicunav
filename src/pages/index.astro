---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Heading from '../components/Heading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleList from '../components/ArticleList.astro';
import { site, proof } from '../data/site';
import { experience } from '../data/experience';
import { services, process } from '../data/services';
import { getArticles, getProjects } from '../lib/content';
import '../styles/profile.css';

const projects = await getProjects('shopify');
const articles = (await getArticles()).slice(0, 3);

const capabilities = [
  { title: 'Themes', body: 'Online Store 2.0 sections and theme blocks, built on metafields and metaobjects, editable by the merchant.' },
  { title: 'Apps & integrations', body: 'Embedded apps, app blocks and webhooks, plus the review, subscription and analytics apps a store already runs.' },
  { title: 'Checkout & Functions', body: 'Checkout UI extensions, discount and validation Functions, B2B and Markets on Shopify Plus.' },
  { title: 'Headless', body: 'Hydrogen storefronts on the Storefront and Customer Account APIs.' },
  { title: 'Catalog data & AI', body: 'Catalogs and custom data rebuilt from code with the Admin API, and AI on top of that data: product recommendations, semantic search, LLM features.' },
  { title: 'Performance', body: 'Core Web Vitals audits and fixes for LCP, INP and CLS, measured before and after.' },
];
---

<Base>
  <section class="hero container">
    <p class="hero__status mono">
      <span class="dot breathe" aria-hidden="true"></span>
      {site.availability}
    </p>
    <Heading
      as="h1"
      class="hero__title"
      parts={[
        { text: 'Shopify stores that load fast, sell more and are ' },
        { text: 'easy to change', tone: 'mark' },
        { text: '.' },
      ]}
    />
    <p class="lede">
      I’m {site.name}, a <strong>senior Shopify developer</strong>. For more than nine years I’ve
      built and run stores for international DTC brands: custom themes, app integrations, Core Web
      Vitals work, A/B tests and Magento to Shopify migrations. Today I work across themes, apps,
      checkout, Hydrogen and the Shopify APIs.
    </p>
    <div class="button-row">
      <a class="button button--primary" href="/work">See the work</a>
      <a class="button button--ghost" href={site.cvShopify}>Download CV</a>
    </div>
    <p class="mono muted">I also build WordPress sites. <a class="link" href="/wordpress">See the WordPress work →</a></p>
  </section>

  <section class="container" aria-label="Track record">
    <ul class="proof" data-reveal-stagger>
      {
        proof.map((p) => (
          <li>
            <span class="proof__value">{p.value}</span>
            <span class="proof__label mono muted">{p.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="employers mono muted">
      {experience.map((e, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <span><span class="employers__name">{e.company}</span>, {e.period.replace(/^\w+ /, '').replace(/ — \w+ /, '–')}</span>
        </>
      ))}
    </p>
  </section>

  <section class="section container" aria-labelledby="work-title">
    <SectionLabel index="01" label="Selected work" />
    <div class="split-heading">
      <Heading id="work-title" class="h2" parts={[{ text: 'Six concept stores. ', tone: 'lead' }, { text: 'Each one solves a different selling problem.' }]} />
      <a class="mono link" href="/work">All projects →</a>
    </div>
    <p class="access mono muted">Every store is open to browse. Password: <code>{site.storePassword}</code></p>
    <div class="grid-2" data-reveal-stagger>
      {
        projects.map((p) => (
          <ProjectCard project={p} />
        ))
      }
    </div>
  </section>

  <section class="section container" aria-labelledby="cap-title">
    <SectionLabel index="02" label="Capabilities" />
    <Heading id="cap-title" class="h2" parts={[{ text: 'The whole Shopify surface, ', tone: 'lead' }, { text: 'not just the theme.' }]} />
    <ul class="caps" data-reveal-stagger>
      {
        capabilities.map((c, i) => (
          <li>
            <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.title}</h3>
            <p class="muted">{c.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="services-title">
    <SectionLabel index="03" label="Services" />
    <div class="split-heading">
      <Heading id="services-title" class="h2" parts={[{ text: 'Need it built? ', tone: 'lead' }, { text: 'Hire me for a project, or for your team.' }]} />
      <a class="mono link" href="/services">All services →</a>
    </div>
    <ul class="caps" data-reveal-stagger>
      {
        services.slice(0, 3).map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p class="muted">{s.outcome}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="process-title">
    <SectionLabel index="04" label="How I work" />
    <Heading id="process-title" class="h2" parts={[{ text: 'Specs before code. Reviews before merge. ', tone: 'lead' }, { text: 'Nothing touches live by surprise.' }]} />
    <ol class="process" data-reveal-stagger>
      {
        process.map((p, i) => (
          <li>
            <span class="mono process__step">{String(i + 1).padStart(2, '0')} {p.step}</span>
            <p>{p.artifact}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    articles.length > 0 && (
      <section class="section container" aria-labelledby="articles-title">
        <SectionLabel index="05" label="Articles" />
        <div class="split-heading">
          <Heading id="articles-title" class="h2" parts={[{ text: 'Notes ', tone: 'lead' }, { text: 'from the work.' }]} />
          <a class="mono link" href="/articles">All articles →</a>
        </div>
        <div data-reveal><ArticleList articles={articles} /></div>
      </section>
    )
  }

  <section class="section container closing">
    <Heading class="h2" parts={[{ text: 'Have a Shopify project ', tone: 'lead' }, { text: 'or an open role?' }]} />
    <p class="lede" data-reveal>Tell me what you’re building. I reply within one business day.</p>
    <div class="button-row" data-reveal>
      <a class="button button--primary" href="/contact">Get in touch</a>
      <a class="button button--ghost" href={site.cvShopify}>Download CV</a>
    </div>
  </section>
</Base>
