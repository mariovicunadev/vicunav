---
import Base from '../../../layouts/Base.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import ArticleList from '../../../components/ArticleList.astro';
import { getArticles } from '../../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  const tags = [...new Set(articles.flatMap((a) => a.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, articles: articles.filter((a) => a.data.tags.includes(tag)) },
  }));
}

const { tag, articles } = Astro.props;
---

<Base title={`#${tag}`} description={`Articles tagged ${tag}.`}>
  <section class="container page-head">
    <SectionLabel label="Articles" />
    <h1>#{tag}</h1>
    <a class="mono" href="/articles">← All articles</a>
  </section>
  <section class="container list">
    <ArticleList articles={articles} />
  </section>
</Base>

<style>
  .page-head {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-9) var(--space-7);
  }

  h1 {
    font-size: var(--step-4);
  }

  .list {
    padding-bottom: var(--space-9);
  }
</style>
