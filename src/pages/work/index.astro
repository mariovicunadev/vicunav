---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { getProjects } from '../../lib/content';
import { site } from '../../data/site';

const projects = await getProjects();
---

<Base title="Work" description="Six concept stores on Shopify Plus, each on a different Horizon-family theme, broken down into features: the problem, the decision, how it was built and checked.">
  <section class="container page-head">
    <SectionLabel label="Work" />
    <h1>Six stores, six selling problems.</h1>
    <p class="lede">
      Each store is a concept brand I designed and built on Shopify Plus, each on a different theme
      from the Horizon family. Open one to see its features: the problem, the decision, how it was
      built and how it was checked.
    </p>
    <p class="access mono">
      Every store is open to preview. Password: <code>{site.storePassword}</code>
    </p>
  </section>
  <section class="container grid" data-reveal-stagger>
    {
      projects.map((p) => (
        <ProjectCard project={p} />
      ))
    }
  </section>
</Base>

<style>
  .page-head {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-9) var(--space-7);
  }

  h1 {
    font-size: var(--step-4);
  }

  .access code {
    padding: 0.05em 0.35em;
    font-weight: 600;
    background: var(--mark-fill);
    color: var(--mark-ink);
    border-radius: var(--radius);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: var(--space-8) var(--space-6);
    padding-bottom: var(--space-9);
  }
</style>
