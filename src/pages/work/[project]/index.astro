---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Chip from '../../../components/Chip.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import SpecTable from '../../../components/SpecTable.astro';
import Window from '../../../components/Window.astro';
import { featureSlug, getFeatures, getProjects } from '../../../lib/content';
import { site, surfaces } from '../../../data/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { project: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const features = await Promise.all(
  (await getFeatures(project.id)).map(async (f) => ({ f, slug: featureSlug(f), Body: (await render(f)).Content })),
);

const repoLabel = {
  public: 'Public',
  private: 'Private',
  'on-request': 'Read access on request',
}[p.repo.visibility];
const storeHost = new URL(p.live.url).host;
---

<Base title={p.title} description={p.summary}>
  <article>
    <header class="container head">
      <nav class="mono crumbs" aria-label="Breadcrumb">
        <a href="/work">Work</a> / <span aria-current="page">{p.title}</span>
      </nav>
      {p.kind === 'concept' && <div class="head__meta"><Chip label="Concept brand — not a client" /></div>}
      <h1>{p.title}</h1>
      <p class="lede">{p.summary}</p>
    </header>

    <div class="container layout">
      <aside class="layout__aside">
        <SpecTable
          rows={[
            { key: 'Niche', value: p.niche },
            { key: 'Base theme', value: p.baseTheme },
            { key: 'Role', value: p.role },
            { key: 'Year', value: String(p.year) },
            { key: 'Surfaces', value: p.surfaces.map((s) => surfaces[s]).join(', ') },
            { key: 'Stack', value: p.stack.join(', ') },
            { key: 'Source', value: repoLabel },
          ]}
        />
        {
          p.metrics.length > 0 && (
            <ul class="metrics">
              {p.metrics.map((m) => (
                <li>
                  <span class="metrics__value">{m.value}</span>
                  <span class="mono muted">{m.label}</span>
                </li>
              ))}
            </ul>
          )
        }
        <div class="store">
          <p class="store__label mono">Live store · {storeHost}</p>
          <p class="store__password">Password: <code>{site.storePassword}</code></p>
          <p class="muted">Public password, no need to ask for access.</p>
          <a class="button button--primary" href={p.live.url}>View the store</a>
        </div>
        {
          p.repo.url && p.repo.visibility === 'public' && (
            <div class="button-row aside__actions">
              <a class="button button--ghost" href={p.repo.url}>Source</a>
            </div>
          )
        }
      </aside>

      <div class="layout__main">
        {p.cover && <Image class="cover" src={p.cover} alt={p.coverAlt ?? ''} widths={[800, 1400]} sizes="(min-width: 60rem) 48rem, 100vw" />}
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    {
      features.length > 0 && (
        <section class="section container" aria-labelledby="features-title">
          <SectionLabel index="01" label="Features" />
          <h2 id="features-title" class="features__title">Feature breakdown</h2>
          <ol class="features" data-reveal-stagger>
            {features.map(({ f, slug, Body }, i) => (
              <li>
                <details class="feature" id={slug} open={i === 0}>
                  <summary>
                    <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="feature__title">{f.data.title}</h3>
                    <span class="feature__toggle" aria-hidden="true" />
                    <span class="feature__problem">{f.data.problem}</span>
                  </summary>
                  <div class="feature__body">
                    <div>
                      {(f.data.demo.length > 0 || f.data.video) && (
                        <div class="feature__media">
                          {f.data.video && (
                            <Window title={`${p.title} · ${f.data.title}`}>
                              <video src={f.data.video} controls muted playsinline preload="metadata" />
                            </Window>
                          )}
                          {f.data.demo.map((d) => (
                            <Window title={`${p.title} · ${f.data.title}`}>
                              <Image src={d.src} alt={d.alt} widths={[800, 1400]} sizes="(min-width: 64rem) 48rem, 100vw" />
                            </Window>
                          ))}
                        </div>
                      )}
                      <p class="feature__label mono">Decision</p>
                      <p class="feature__decision">{f.data.decision}</p>
                      <div class="prose">
                        <Body />
                      </div>
                    </div>
                    <div class="feature__side">
                      {f.data.quality.length > 0 && (
                        <div>
                          <p class="feature__label mono">Quality</p>
                          <ul class="quality">
                            {f.data.quality.map((q) => <li>{q}</li>)}
                          </ul>
                        </div>
                      )}
                      <div>
                        <p class="feature__label mono">Surfaces and skills</p>
                        <ul class="chips">
                          {f.data.surfaces.map((s) => <li><Chip label={surfaces[s]} /></li>)}
                          {f.data.skills.map((s) => <li><Chip label={s} /></li>)}
                        </ul>
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      next.id !== project.id && (
        <nav class="container next" aria-label="Next project">
          <span class="mono muted">Next project</span>
          <a class="link" href={`/work/${next.id}`}>{next.data.title} →</a>
        </nav>
      )
    }
  </article>

  <script is:inline>
    // Old feature URLs redirect to /work/<project>#<feature>: open that row and bring it into view.
    (() => {
      const open = () => {
        const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (el instanceof HTMLDetailsElement) {
          el.open = true;
          el.scrollIntoView();
        }
      };
      open();
      addEventListener('hashchange', open);
    })();
  </script>
</Base>

<style>
  .head {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-7);
  }

  .crumbs {
    color: var(--color-muted);
  }

  .head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
  }

  .layout {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 20rem 1fr;
    }

    .layout__aside {
      position: sticky;
      top: 6rem; /* clears the sticky header */
      align-self: start;
    }
  }

  .metrics {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .metrics li {
    display: grid;
  }

  .metrics__value {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .store {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-window);
    background: var(--color-surface);
  }

  .store__label {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .store__password {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .store__password code {
    padding: 0.05em 0.35em;
    font-family: var(--font-mono);
    background: var(--mark-fill);
    color: var(--mark-ink);
    border-radius: var(--radius);
  }

  .store .button {
    justify-self: start;
    margin-top: var(--space-3);
  }

  .aside__actions {
    margin-top: var(--space-5);
  }

  .cover {
    width: 100%;
    margin-bottom: var(--space-7);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }

  .features__title {
    font-size: var(--step-3);
    margin-bottom: var(--space-6);
  }

  .features {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-text);
  }

  .features > li {
    border-bottom: 1px solid var(--color-line);
  }

  .feature summary {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: var(--space-1) var(--space-4);
    align-items: baseline;
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  .feature summary::-webkit-details-marker {
    display: none;
  }

  .feature__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .feature__toggle {
    font-family: var(--font-mono);
    color: var(--color-muted);
  }

  .feature__toggle::before {
    content: '+';
  }

  .feature[open] .feature__toggle::before {
    content: '−';
  }

  .feature__problem {
    grid-column: 2;
    color: var(--color-muted);
    max-width: var(--prose-width);
  }

  .feature summary:hover .feature__title,
  .feature summary:focus-visible .feature__title {
    color: var(--color-accent-ink);
  }

  .feature__body {
    display: grid;
    gap: var(--space-6);
    padding: 0 0 var(--space-7) calc(2.5rem + var(--space-4));
  }

  @media (max-width: 40rem) {
    .feature__body {
      padding-left: 0;
    }
  }

  @media (min-width: 64rem) {
    .feature__body {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }
  }

  .feature__label {
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .feature__decision {
    margin-bottom: var(--space-5);
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: var(--prose-width);
  }

  .feature__media {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .feature__side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .quality {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .quality li {
    position: relative;
    padding-left: var(--space-5);
  }

  .quality li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-ok);
    font-family: var(--font-mono);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .next {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .next a {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
</style>
