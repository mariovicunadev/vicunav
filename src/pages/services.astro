---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { services, process, faq } from '../data/services';
import { site } from '../data/site';
---

<Base title="Services" description="Shopify development services: custom themes, store features and integrations, speed audits, migrations, headless storefronts and ongoing development.">
  <section class="container page-head">
    <SectionLabel label="Services" />
    <h1>Shopify development, scoped and shipped.</h1>
    <p class="lede">
      Fixed-scope projects or ongoing work for merchants and agencies. Every engagement starts
      with a written scope and acceptance criteria, so you know what “done” means before I start.
    </p>
    <div class="button-row">
      <a class="button button--primary" href="/contact">Send a brief</a>
      {site.socials.upwork && <a class="button button--ghost" href={site.socials.upwork}>Hire on Upwork</a>}
    </div>
  </section>

  <section class="container">
    <ul class="services" data-reveal-stagger>
      {
        services.map((s, i) => (
          <li id={s.id}>
            <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
            <div class="services__body">
              <h2>{s.title}</h2>
              <p class="services__outcome">{s.outcome}</p>
              <ul class="services__includes">
                {s.includes.map((x) => <li>{x}</li>)}
              </ul>
            </div>
            <span class="mono services__price">{s.from}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container" aria-labelledby="process-title">
    <SectionLabel index="01" label="Process" />
    <h2 id="process-title" class="h2">What working together looks like</h2>
    <ol class="steps">
      {
        process.map((p, i) => (
          <li>
            <span class="mono">{String(i + 1).padStart(2, '0')} — {p.step}</span>
            <p class="muted">{p.artifact}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container" aria-labelledby="faq-title">
    <SectionLabel index="02" label="FAQ" />
    <h2 id="faq-title" class="h2">Questions</h2>
    <div class="faq">
      {
        faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .page-head {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-9) var(--space-7);
  }

  h1 {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .h2 {
    font-size: var(--step-3);
    margin-bottom: var(--space-6);
  }

  .services {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-text);
  }

  .services > li {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: var(--space-6);
  }

  .services__body {
    display: grid;
    gap: var(--space-3);
  }

  .services h2 {
    font-size: var(--step-2);
  }

  .services__outcome {
    font-size: var(--step-1);
    color: var(--color-muted);
    max-width: 50ch;
  }

  .services__includes {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: var(--space-1);
  }

  .services__price {
    color: var(--color-accent-ink);
    white-space: nowrap;
  }

  @media (max-width: 45rem) {
    .services > li {
      grid-template-columns: 2.5rem 1fr;
    }

    .services__price {
      grid-column: 2;
    }
  }

  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 40rem) {
    .steps li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  .faq {
    border-top: 1px solid var(--color-text);
    max-width: 50rem;
  }

  details {
    border-bottom: 1px solid var(--color-line);
  }

  summary {
    cursor: pointer;
    padding-block: var(--space-4);
    font-size: var(--step-1);
    font-weight: 600;
  }

  details p {
    padding-bottom: var(--space-5);
  }
</style>
