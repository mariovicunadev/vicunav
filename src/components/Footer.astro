---
import { site } from '../data/site';

const links = [
  { href: `mailto:${site.email}`, label: 'Email' },
  { href: site.socials.linkedin, label: 'LinkedIn' },
  { href: site.socials.github, label: 'GitHub' },
  { href: site.socials.upwork, label: 'Upwork' },
  { href: '/rss.xml', label: 'RSS' },
  { href: site.cv, label: 'CV (PDF)' },
].filter((l) => l.href);
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <p class="footer__cta">Have a Shopify project or a role in mind?</p>
      <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <ul class="footer__links mono">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <p class="footer__meta mono muted">
      <span class="dot" aria-hidden="true"></span>
      {site.availability} · {site.location}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-8) var(--space-6);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  .footer__cta {
    font-size: var(--step-1);
    color: var(--color-muted);
  }

  .footer__email {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    display: inline-block;
    padding-block: var(--space-1);
  }

  .footer__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-ok);
  }
</style>
