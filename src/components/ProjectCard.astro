---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Chip from './Chip.astro';
import { surfaces } from '../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
  featureCount?: number;
}

const { project, featureCount } = Astro.props;
const p = project.data;
---

<article class="card">
  <div class="card__media">
    {
      p.cover ? (
        <Image src={p.cover} alt={p.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 36rem, 100vw" />
      ) : (
        <div class="card__placeholder" aria-hidden="true">
          <span>{p.title}</span>
        </div>
      )
    }
  </div>
  <div class="card__body">
    <div class="card__meta mono muted">
      <span>{p.year}</span>
      <span>{p.kind === 'concept' ? 'Concept brand' : p.role}</span>
      <Chip status={p.status} />
    </div>
    <h3 class="card__title">
      <a href={`/work/${project.id}`}>{p.title}</a>
    </h3>
    <p class="muted">{p.summary}</p>
    <ul class="card__tags" aria-label="Shopify surfaces">
      {p.surfaces.map((s) => <li><Chip label={surfaces[s]} /></li>)}
    </ul>
    {featureCount ? <p class="mono muted">{featureCount} features documented →</p> : null}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-5);
  }

  .card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .card:hover .card__media :global(img) {
    transform: scale(1.02);
  }

  .card__placeholder {
    display: grid;
    place-items: end start;
    height: 100%;
    padding: var(--space-5);
    background:
      repeating-linear-gradient(90deg, var(--color-line) 0 1px, transparent 1px 3rem),
      repeating-linear-gradient(0deg, var(--color-line) 0 1px, transparent 1px 3rem);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .card__body {
    display: grid;
    gap: var(--space-3);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .card__title {
    font-size: var(--step-2);
  }

  .card__title a {
    text-decoration: none;
  }

  /* Whole card is clickable; the link stays the only focusable element. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
