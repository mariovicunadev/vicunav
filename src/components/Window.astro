---
/** App-window frame for demos (spec 008). Code blocks get the same frame from the Shiki transformer. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="window">
  <div class="window__bar" aria-hidden="true">
    <span class="window__dots"></span>
    <span>{title}</span>
  </div>
  <slot />
</div>
