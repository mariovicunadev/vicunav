---
interface Props {
  rows: { key: string; value?: string | null }[];
}

const rows = Astro.props.rows.filter((r) => r.value);
---

<dl class="spec">
  {
    rows.map((r) => (
      <div class="spec__row">
        <dt class="mono muted">{r.key}</dt>
        <dd>{r.value}</dd>
      </div>
    ))
  }
  <slot />
</dl>

<style>
  .spec {
    margin: 0;
    border-top: 1px solid var(--color-text);
  }

  .spec :global(.spec__row) {
    display: grid;
    grid-template-columns: minmax(7rem, 1fr) 2fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .spec :global(dt) {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spec :global(dd) {
    margin: 0;
  }
</style>
